{
  "name": "Radio",
  "origin": "figma",
  "originLabel": "Figma 来源",
  "purpose": "表达一组互斥的基础选择。",
  "constraints": [
    "同组使用一致 name 和不同 optionValue；基础 Radio 不等于 Radio select 复合组件。"
  ],
  "marker": "<div data-pd=\"Radio\" data-options='{}'></div>",
