        "String",
        "Number",
        "Boolean"
      ],
      "default": {
        "kind": "vue-implicit",
        "value": false,
        "note": "缺省为 false；空字符串强制转换取决于 Boolean/String 声明顺序。"
      },
      "required": true
    },
    {
