{
  "name": "Space",
  "origin": "original",
  "originLabel": "自主创建",
  "purpose": "用本地间距 Token 组织横向或纵向内容。",
  "constraints": [
    "gap 使用已有 spacing 名称，不接受 safe-area 名称；不能替代页面安全区处理。"
  ],
  "marker": "<div data-pd=\"Space\" data-options='{}'></div>",
  "options": [
    {
      "name": "gap",
      "types": [
        "String"
      ],
      "default": {
        "kind": "literal",
        "expression": "'xs'",
        "value": "xs"
      },
      "required": false
    },
    {
      "name": "direction",
      "types": [
        "String"
      ],
      "default": {
        "kind": "literal",
        "expression": "'horizontal'",
        "value": "horizontal"
      },
      "required": false,
      "allowed": [
        "horizontal",
        "vertical"
      ]
    },
    {
      "name": "align",
      "types": [
        "String"
      ],
      "default": {
        "kind": "literal",
        "expression": "'center'",
        "value": "center"
      },
      "required": false,
      "allowed": [
        "start",
        "center",
        "end",
        "stretch"
      ]
    },
    {
      "name": "wrap",
      "types": [
        "Boolean"
      ],
      "default": {
        "kind": "literal",
        "expression": "true",
        "value": true
      },
      "required": false
    }
  ],
  "events": [],
  "contents": [
    {
      "name": "default",
      "description": "默认内容；回退内容及条件按模板。",
      "usage": "原生 DOM 节点或接收内容上下文的函数"
    }
  ],
  "methods": [],
  "knownDifferences": [],
  "designTarget": {
    "origin": "original",
    "tokenReference": "tokens/component.json#space",
    "gaps": "自主组件按本地 Token 验收，不宣称有对应 Figma 完整变体。"
  },
  "verification": {
    "status": "requires-current-evidence",
    "report": "verification/report.json",
    "scope": "当前 HTML 构建的交互、尺寸和截图对照；不扩大为完整设计认证。"
  },
  "examples": [
    "space--playground",
    "space--examples"
  ]
}
