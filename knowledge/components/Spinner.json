{
  "name": "Spinner",
  "origin": "original",
  "originLabel": "自主创建",
  "purpose": "表达正在进行的短时活动并提供名称。",
  "constraints": [
    "Spinner 不是 Figma Loading 整页/遮罩；是否阻断操作由当前任务决定。"
  ],
  "marker": "<div data-pd=\"Spinner\" data-options='{}'></div>",
  "options": [
    {
      "name": "size",
      "types": [
        "String"
      ],
      "default": {
        "kind": "literal",
        "expression": "'medium'",
        "value": "medium"
      },
      "required": false,
      "allowed": [
        "small",
        "medium",
        "large"
      ]
    },
    {
      "name": "label",
      "types": [
        "String"
      ],
      "default": {
        "kind": "literal",
        "expression": "'Loading'",
        "value": "Loading"
      },
      "required": false
    }
  ],
  "events": [],
  "contents": [],
  "methods": [],
  "knownDifferences": [],
  "designTarget": {
    "origin": "original",
    "tokenReference": "tokens/component.json#spinner",
    "gaps": "自主组件按本地 Token 验收，不宣称有对应 Figma 完整变体。"
  },
  "verification": {
    "status": "requires-current-evidence",
    "report": "verification/report.json",
    "scope": "当前 HTML 构建的交互、尺寸和截图对照；不扩大为完整设计认证。"
  },
  "examples": [
    "spinner--playground",
    "spinner--examples"
  ]
}
