{
  "name": "Form",
  "origin": "original",
  "originLabel": "自主创建",
  "purpose": "汇总字段校验并发出提交或无效事件。",
  "constraints": [
    "只管理 UI 校验；model prop 不是 双向值绑定 契约，不执行金融业务提交。"
  ],
  "marker": "<div data-pd=\"Form\" data-options='{}'></div>",
  "options": [
    {
      "name": "model",
      "types": [
        "Object"
      ],
      "default": {
        "kind": "factory-literal",
        "expression": "() => ({})",
        "value": {}
      },
      "required": false
    },
    {
      "name": "rules",
      "types": [
        "Object"
      ],
      "default": {
        "kind": "factory-literal",
        "expression": "() => ({})",
        "value": {}
      },
      "required": false
    },
    {
      "name": "disabled",
      "types": [
        "Boolean"
      ],
      "default": {
        "kind": "vue-implicit",
        "value": false,
        "note": "未传 Boolean prop 时 当前基准实现 使用 false。"
      },
      "required": false
    }
  ],
  "events": [
    {
      "name": "pd:invalid",
      "detail": "{ value, args }",
      "description": "Object：字段错误映射。"
    },
    {
      "name": "pd:submit",
      "detail": "{ value, args }",
      "description": "Object：当前 model；调用方负责实际提交。"
    },
    {
      "name": "pd:validate",
      "detail": "{ value, args }",
      "description": "(valid: Boolean, errors: Object)：校验结果及错误映射。"
    }
  ],
  "contents": [
    {
      "name": "default",
      "description": "字段内容；作用域提供 errors、disabled、validating，调用方绑定到对应控件。",
      "usage": "原生 DOM 节点或接收内容上下文的函数"
    }
  ],
  "methods": [
    "validate",
    "resetValidation"
  ],
  "knownDifferences": [],
  "designTarget": {
    "origin": "original",
    "tokenReference": "tokens/component.json#form",
    "gaps": "自主组件按本地 Token 验收，不宣称有对应 Figma 完整变体。"
  },
  "verification": {
    "status": "requires-current-evidence",
    "report": "verification/report.json",
    "scope": "当前 HTML 构建的交互、尺寸和截图对照；不扩大为完整设计认证。"
  },
  "examples": [
    "form--playground",
    "form--async-validation"
  ]
}
